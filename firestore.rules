rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    // HELPER FUNCTIONS
    // =============================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user profile exists
    function userDocExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // Check if user is accessing their own document
    function isOwner(uid) {
      return isAuthenticated() && (
        request.auth.uid == uid || 
        (userDocExists(uid) && getUserProfile(uid).uid == request.auth.uid)
      );
    }

    // Get user's profile data
    function getUserProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Check if authenticated user is an admin
    function isAdmin() {
      return isAuthenticated() && (
        (userDocExists(request.auth.uid) && getUserProfile(request.auth.uid).role == 'admin') ||
        request.auth.token.email == 'jordi@23lunes.studio' ||
        request.auth.token.email == 'misterpotatolightyear@gmail.com'
      );
    }

    // Check if user is a manager of a specific username
    function isManagerOf(targetUsername) {
      return isAuthenticated() &&
             userDocExists(request.auth.uid) &&
             getUserProfile(request.auth.uid).managed_users != null &&
             targetUsername in getUserProfile(request.auth.uid).managed_users;
    }

    // Check if user can access a specific user document (owner or manager)
    function canAccessUser(targetUid) {
      return isOwner(targetUid) ||
             (userDocExists(targetUid) &&
              isManagerOf(getUserProfile(targetUid).username));
    }

    // Self-registration is limited to a safe subset of fields and always starts as player
    function isOwnerCreatingProfile(userId) {
      return isOwner(userId) &&
             request.resource.data.uid == request.auth.uid &&
             request.resource.data.role == 'player' &&
             request.resource.data.managed_users is list &&
             request.resource.data.managed_users.size() == 0;
    }

    // Owners can only edit non-privileged profile fields
    function isOwnerProfileUpdate(userId) {
      return isOwner(userId) &&
             request.resource.data.uid == resource.data.uid &&
             request.resource.data.username == resource.data.username &&
             request.resource.data.role == resource.data.role &&
             request.resource.data.managed_users == resource.data.managed_users &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'full_name',
               'first_name',
               'last_name_1',
               'last_name_2',
               'federation_id',
               'email',
               'photo_url',
               'handicap_url',
               'current_handicap',
               'handicap_pdf_url',
               'handicap_fetched_at',
               'club',
               'profile_completed',
               'profile_completed_at',
               'search_text',
               'updated_at'
             ]);
    }

    // =============================================================
    // USERS COLLECTION
    // =============================================================

    match /users/{userId} {
      // Read: Anyone (public for resolving profiles in live mode)
      allow read: if true;

      // Create: admin or the authenticated user creating their own player profile
      allow create: if isAdmin() || isOwnerCreatingProfile(userId);

      // Update: admin or owner editing only safe profile fields
      allow update: if isAdmin() || isOwnerProfileUpdate(userId);

      // Delete: admin only
      allow delete: if isAdmin();

      // Subcollections
      match /results/{resultId} {
        // Read: Owner, manager, or public (for live scorecards)
        allow read: if true; // Public read for live mode

        // Write: Owner, manager, or admin
        allow write: if isAdmin() || canAccessUser(userId);
      }

            match /custom_tournaments/{tournamentId} {
        // Read: Anyone (public to see custom pars in live mode)
        allow read: if true;

        // Write: Owner, manager, or admin
        allow write: if isAdmin() || canAccessUser(userId);
      }

            match /handicap_history/{historyId} {
        // Read: Public (to allow unauthenticated single-app modes to read history)
        allow read: if true;

        // Write: Public (to allow ANY single-app user to automatically save their fetched RFEG data without needing to log in)
        allow write: if true;
      }

      match /settings/{settingId} {
        // Read: Owner, manager, or admin
        allow read: if isAdmin() || canAccessUser(userId);

        // Write: Owner, manager, or admin
        allow write: if isAdmin() || canAccessUser(userId);
      }

      match /subscribed_tournaments/{tournamentId} {
        // Read: Anyone (public)
        allow read: if true;

        // Write: Owner, manager, or admin
        allow write: if isAdmin() || canAccessUser(userId);
      }
    }

    // =============================================================
    // USERNAMES MAPPING COLLECTION
    // =============================================================

    match /usernames/{username} {
      // Read: Anyone (needed for public live user lookup)
      allow read: if true;

      // Write: Only admin, or the owner of the UID can create their own mapping
      allow write: if isAdmin() || (isAuthenticated() && request.resource.data.uid == request.auth.uid);
    }

    // =============================================================
    // FRIENDS / COMMUNITY
    // =============================================================

    match /friend_requests/{requestId} {
      allow read: if isAdmin() || (
        isAuthenticated() &&
        (resource.data.from_uid == request.auth.uid || resource.data.to_uid == request.auth.uid)
      );

      allow create: if isAuthenticated() &&
        request.resource.data.from_uid == request.auth.uid &&
        request.resource.data.to_uid is string &&
        request.resource.data.status == 'pending';

      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.to_uid == request.auth.uid &&
        request.resource.data.from_uid == resource.data.from_uid &&
        request.resource.data.to_uid == resource.data.to_uid &&
        request.resource.data.status in ['accepted', 'rejected']
      );

      allow delete: if isAdmin() || (
        isAuthenticated() &&
        (resource.data.from_uid == request.auth.uid || resource.data.to_uid == request.auth.uid)
      );
    }

    match /friendships/{friendshipId} {
      allow read: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid in resource.data.members
      );

      allow create: if isAuthenticated() &&
        (
          isAdmin() ||
          request.auth.uid in request.resource.data.members
        ) &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2;

      allow update: if isAdmin();

      allow delete: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid in resource.data.members
      );
    }

    match /chats/{chatId} {
      allow read: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid in resource.data.members
      );

      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/friendships/$(chatId)) &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2;

      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid in resource.data.members &&
        request.resource.data.members == resource.data.members
      );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (
          isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
        );

        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
          request.resource.data.sender_uid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000;

        allow update, delete: if false;
      }
    }

    match /chat_reports/{reportId} {
      allow create: if isAuthenticated() &&
        request.resource.data.reporter_uid == request.auth.uid &&
        request.resource.data.chat_id is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.reason.size() <= 500;

      allow read, update, delete: if isAdmin();
    }

    // =============================================================
    // TOURNAMENTS COLLECTION (Global)
    // =============================================================

    match /tournaments/{tournamentId} {
      // Read: Anyone (public tournaments)
      allow read: if true;

      // Write: Only admin for main doc, but users can write to participants subcollection
      allow write: if isAdmin();

      match /participants/{username} {
        // Read: Anyone (public leaderboard)
        allow read: if true;

        // Write: Any authenticated user can write their own participant data
        // (Usually username is the document ID)
        allow write: if isAuthenticated() && (request.auth.uid != null);
      }
    }

    // Keep tournaments_leaderboard as an alias for future migration if needed
    match /tournaments_leaderboard/{tournamentId} {
      allow read: if true;
      allow write: if isAuthenticated();
      match /participants/{username} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    match /shared_tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // System config (feature flags, settings)
    match /system_config/{documentId} {
      allow read, write: if isAdmin();
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
